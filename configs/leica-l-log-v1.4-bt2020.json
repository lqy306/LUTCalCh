{
  "schema": "lutcalc-log-gamma-profile",
  "version": 1,
  "id": "leica-l-log-v1.4-bt2020",
  "name": "徕卡 L-Log v1.4（BT.2020）",
  "kind": "log",
  "author": "Leica Camera；LUTCalc 配置整理",
  "description": "适用于 Leica SL2、SL2-S 与 Q3 的 L-Log 参考配置。完整数据范围；18% 中灰约为 44% IRE。",
  "input": {
    "gamut": "ITU-R BT.2020",
    "range": "full",
    "bitDepth": 10
  },
  "curve": {
    "type": "formula",
    "encode": "input <= 0.006 ? 8 * input + 0.09 : 0.27 * log10(1.3 * input + 0.0115) + 0.6",
    "decode": "input <= 0.138 ? (input - 0.09) / 8 : (pow(10, (input - 0.6) / 0.27) - 0.0115) / 1.3"
  },
  "colorSpace": {
    "primaries": "ITU-R BT.2020",
    "whitePoint": "D65",
    "toXYZ": [
      [0.637, 0.1446, 0.1689],
      [0.2627, 0.678, 0.0593],
      [0, 0.0281, 1.061]
    ]
  },
  "metadata": {
    "middleGrayIRE": 44,
    "source": "https://leica-camera.com/sites/default/files/pm-101410-l-log_reference_manual_v1.4.pdf"
  }
}
