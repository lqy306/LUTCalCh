{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lutcalcapp-s8bmtac7.manus.space/schemas/lutcalc-log-gamma-profile.schema.json",
  "title": "LUTCalc Log Gamma Profile",
  "type": "object",
  "required": ["schema", "version", "id", "name", "kind", "curve"],
  "properties": {
    "schema": { "const": "lutcalc-log-gamma-profile" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "kind": { "enum": ["log", "gamma"] },
    "author": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "input": {
      "type": "object",
      "properties": {
        "gamut": { "type": "string", "maxLength": 120 },
        "range": { "enum": ["full", "video"] },
        "bitDepth": { "type": "integer", "minimum": 8, "maximum": 32 }
      },
      "additionalProperties": false
    },
    "curve": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["samples", "formula"] },
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["input", "output"],
            "properties": {
              "input": { "type": "number", "minimum": 0, "maximum": 1 },
              "output": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "encode": { "type": "string", "maxLength": 4000 },
        "decode": { "type": "string", "maxLength": 4000 }
      },
      "additionalProperties": false
    },
    "colorSpace": {
      "type": "object",
      "properties": {
        "primaries": { "type": "string", "maxLength": 120 },
        "whitePoint": { "type": "string", "maxLength": 40 },
        "toXYZ": {
          "type": "array",
          "prefixItems": [
            { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
            { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
            { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "middleGrayIRE": { "type": "number", "minimum": 0, "maximum": 109 },
        "source": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
