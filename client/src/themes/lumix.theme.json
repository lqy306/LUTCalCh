{
  "$schema": "./lutcalc-theme.schema.json",
  "id": "lumix",
  "name": "Lumix 固件",
  "description": "参考 Lumix 设置菜单的深石墨层级、冷蓝状态提示、紧凑标签与清晰分组。",
  "fontFamily": "'Noto Sans SC', 'Helvetica Neue', Arial, sans-serif",
  "radius": "4px",
  "modes": {
    "light": { "label": "亮色", "colors": { "canvas": "#e5e8eb", "surface": "#f1f3f5", "surfaceMuted": "#d8dde2", "sidebar": "#eef1f4", "card": "#ffffff", "text": "#17212b", "muted": "#5e6b77", "border": "#b9c2cb", "accent": "#087fbc", "accentHover": "#066b9e", "accentSoft": "#e4f3fb", "topbar": "#14202b", "topbarText": "#ffffff", "control": "#f7f8f9", "controlHover": "#e7edf1", "input": "#ffffff", "inputDisabled": "#dfe4e8", "focus": "rgba(8,127,188,.34)", "success": "#2c9a61", "danger": "#d64b45", "shadow": "0 1px 3px rgba(23,33,43,.14)", "link": "#066b9e", "previewBlend": "multiply" } },
    "dark": { "label": "深色", "colors": { "canvas": "#12181d", "surface": "#1b242b", "surfaceMuted": "#26313a", "sidebar": "#172027", "card": "#202a32", "text": "#f0f4f7", "muted": "#aab7c0", "border": "#455560", "accent": "#39a9dc", "accentHover": "#6bc4ea", "accentSoft": "#15394b", "topbar": "#0b1115", "topbarText": "#ffffff", "control": "#29353d", "controlHover": "#364650", "input": "#182127", "inputDisabled": "#2b363d", "focus": "rgba(57,169,220,.48)", "success": "#62d294", "danger": "#ff796f", "shadow": "0 3px 16px rgba(0,0,0,.36)", "link": "#7bd2f5", "previewBlend": "normal" } }
  }
}
