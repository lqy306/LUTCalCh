{
  "$schema": "./lutcalc-theme.schema.json",
  "id": "leica",
  "name": "Leica 固件",
  "description": "参考 Leica SL3/Q3 固件界面的黑白高对比、克制红色标记与清晰触控层级。",
  "fontFamily": "'Leica LG1056', 'Noto Sans SC', sans-serif",
  "fontFace": {
    "family": "Leica LG1056",
    "source": "data:font/woff2;base64,",
    "weight": "400",
    "style": "normal",
    "format": "woff2"
  },
  "radius": "3px",
  "modes": {
    "light": {
      "label": "亮色",
      "colors": {
        "canvas": "#e9e9e7",
        "surface": "#f4f4f2",
        "surfaceMuted": "#dededb",
        "sidebar": "#f7f7f5",
        "card": "#ffffff",
        "text": "#101010",
        "muted": "#686866",
        "border": "#c9c9c5",
        "accent": "#d71920",
        "accentHover": "#b8141a",
        "accentSoft": "#fde9ea",
        "topbar": "#111111",
        "topbarText": "#ffffff",
        "control": "#f6f6f4",
        "controlHover": "#e7e7e4",
        "input": "#ffffff",
        "inputDisabled": "#e2e2df",
        "focus": "rgba(215,25,32,.34)",
        "success": "#16804a",
        "danger": "#d71920",
        "shadow": "0 1px 2px rgba(0,0,0,.12)",
        "link": "#b8141a",
        "previewBlend": "multiply"
      }
    },
    "dark": {
      "label": "深色",
      "colors": {
        "canvas": "#111111",
        "surface": "#1b1b1a",
        "surfaceMuted": "#282826",
        "sidebar": "#151515",
        "card": "#20201f",
        "text": "#f5f5f2",
        "muted": "#b1b1ad",
        "border": "#4a4a47",
        "accent": "#e31b23",
        "accentHover": "#f14a50",
        "accentSoft": "#482124",
        "topbar": "#050505",
        "topbarText": "#ffffff",
        "control": "#292927",
        "controlHover": "#393936",
        "input": "#191918",
        "inputDisabled": "#2b2b29",
        "focus": "rgba(227,27,35,.46)",
        "success": "#54c58a",
        "danger": "#ff5c62",
        "shadow": "0 3px 16px rgba(0,0,0,.38)",
        "link": "#ff979a",
        "previewBlend": "normal"
      }
    }
  }
}
