{
  "$schema": "./lutcalc-theme.schema.json",
  "id": "macos",
  "name": "macOS",
  "description": "macOS 风格：轻质表面、系统蓝强调与较圆润的窗口层次。",
  "fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', Arial, 'Noto Sans SC', sans-serif",
  "radius": "10px",
  "modes": {
    "light": { "label": "亮色", "colors": { "canvas": "#f5f5f7", "surface": "rgba(255,255,255,.86)", "surfaceMuted": "#f1f2f4", "sidebar": "rgba(255,255,255,.82)", "card": "rgba(255,255,255,.94)", "text": "#1d1d1f", "muted": "#6e6e73", "border": "#d2d2d7", "accent": "#0071e3", "accentHover": "#0077ed", "accentSoft": "#e8f2ff", "topbar": "rgba(245,245,247,.88)", "topbarText": "#1d1d1f", "control": "#ffffff", "controlHover": "#f5f5f7", "input": "#ffffff", "inputDisabled": "#f5f5f7", "focus": "rgba(0,113,227,.28)", "success": "#34c759", "danger": "#ff3b30", "shadow": "0 2px 12px rgba(0,0,0,.06)", "link": "#0071e3", "previewBlend": "multiply" } },
    "dark": { "label": "深色", "colors": { "canvas": "#1c1c1e", "surface": "rgba(44,44,46,.88)", "surfaceMuted": "#2c2c2e", "sidebar": "rgba(39,39,41,.90)", "card": "#2c2c2e", "text": "#f5f5f7", "muted": "#aeaeb2", "border": "#48484a", "accent": "#0a84ff", "accentHover": "#409cff", "accentSoft": "#123a63", "topbar": "rgba(28,28,30,.88)", "topbarText": "#f5f5f7", "control": "#3a3a3c", "controlHover": "#48484a", "input": "#2c2c2e", "inputDisabled": "#3a3a3c", "focus": "rgba(10,132,255,.40)", "success": "#30d158", "danger": "#ff453a", "shadow": "0 5px 18px rgba(0,0,0,.30)", "link": "#64d2ff", "previewBlend": "normal" } }
  }
}
