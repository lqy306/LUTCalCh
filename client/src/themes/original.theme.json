{
  "$schema": "./lutcalc-theme.schema.json",
  "id": "original",
  "name": "Original LUTCalc",
  "description": "原版 LUTCalc 界面风格：深蓝标题栏配黄字、浅灰面板、白底网格与深色标签。",
  "fontFamily": "'Century Gothic', CenturyGothic, 'AppleGothic', 'Noto Sans SC', sans-serif",
  "radius": "4px",
  "modes": {
    "light": { "label": "亮色", "colors": { "canvas": "#e7e7e7", "surface": "#e7e7e7", "surfaceMuted": "#dddddd", "sidebar": "#e7e7e7", "card": "#e7e7e7", "text": "#212121", "muted": "#666666", "border": "#c8c8c8", "accent": "#1f2e98", "accentHover": "#182370", "accentSoft": "#e8ebf9", "topbar": "#1f2e98", "topbarText": "#ffff00", "control": "#dddddd", "controlHover": "#d2d2d2", "input": "#ffffff", "inputDisabled": "#efefef", "focus": "rgba(31,46,152,.35)", "success": "#299c5c", "danger": "#a04040", "shadow": "0.05em 0.05em 0.2em rgba(128,128,128,.55)", "link": "#1f2e98", "previewBlend": "multiply" } },
    "dark": { "label": "深色", "colors": { "canvas": "#23252b", "surface": "#2a2d34", "surfaceMuted": "#343842", "sidebar": "#282b31", "card": "#2e323a", "text": "#e7e7e7", "muted": "#9aa0aa", "border": "#4a4f59", "accent": "#5a6cf0", "accentHover": "#7c8bff", "accentSoft": "#232a4d", "topbar": "#1f2e98", "topbarText": "#ffff00", "control": "#3a3f4a", "controlHover": "#484e5b", "input": "#23262c", "inputDisabled": "#30343b", "focus": "rgba(90,108,240,.40)", "success": "#5ddb8c", "danger": "#e07070", "shadow": "0.05em 0.05em 0.25em rgba(0,0,0,.50)", "link": "#8a97ff", "previewBlend": "normal" } }
  }
}
