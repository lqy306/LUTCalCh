{
  "schema": "lutcalc-log-gamma-profile",
  "version": 2,
  "id": "leica-l-log-v1.4-bt709-sl-typ601",
  "name": "Leica L-Log v1.4（BT.709，SL Typ 601）",
  "brand": "Leica",
  "displayName": "L-Log v1.4（BT.709）",
  "kind": "log",
  "author": "Leica Camera；LUTCalc 配置整理",
  "description": "适用于 Leica SL（Typ 601）的 L-Log 参考配置。该机型使用 BT.709 色彩空间；Leica 白皮书明确说明其不应使用面向新机型的 L-Log LUT。",
  "input": {
    "gamut": "ITU-R BT.709",
    "range": "full",
    "bitDepth": 10
  },
  "curve": {
    "type": "formula",
    "encode": "input <= 0.006 ? 8 * input + 0.09 : 0.27 * log10(1.3 * input + 0.0115) + 0.6",
    "decode": "input <= 0.138 ? (input - 0.09) / 8 : (pow(10, (input - 0.6) / 0.27) - 0.0115) / 1.3",
    "engineParams": [
      0.125,
      -0.01125,
      0.27,
      1.3,
      10,
      0.6,
      0.0115,
      0.138,
      0.006
    ]
  },
  "colorSpace": {
    "primaries": "ITU-R BT.709",
    "whitePoint": "D65"
  },
  "metadata": {
    "middleGrayIRE": 44,
    "source": "https://leica-camera.com/sites/default/files/pm-101410-l-log_reference_manual_v1.4.pdf"
  }
}
